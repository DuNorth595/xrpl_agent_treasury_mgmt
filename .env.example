# Every setting the service reads.
#
# Copy to .env and fill it in, or supply these as real environment
# variables. A real deployment supplies them from a secret store.

# ---------------------------------------------------------------- required

# The XRP Ledger node, as a websocket URL. dev_env.py reads this and
# passes it to run_demo.py as --url.
TREASURY_RIPPLE_WS=ws://127.0.0.1:6006

# The network id. 15791 is the local devnet. This MUST match the node.
#
# NOTE: there is no environment variable for this. The network id is
# the `--network-id` argument to run_demo.py, and nothing reads an
# environment variable for it.

# The API credentials, as a JSON object:
#   {"<name>": {"token": "<plaintext>", "scopes": ["treasury:read"]}}
# Tokens are stored hashed. The plaintext appears here only at mint time.
#
# Generate with:  python3 mint_token.py --name ops --scopes treasury:read
TREASURY_API_TOKENS={}

# ---------------------------------------------------------------- optional

# Where the service listens.
TREASURY_HOST=127.0.0.1
TREASURY_SERVICE_PORT=8095

# The ports and the bind address.
TREASURY_HOST=127.0.0.1
TREASURY_SERVICE_PORT=8095
TREASURY_SIGNER_PORT=8098
TREASURY_FAUCET_URL=http://127.0.0.1:3001/faucet

# The reference ERP. A real deployment points this at the real ERP.
# Passed to run_demo.py as --erp-url.
S_DEVLAB_ERP_URL=http://127.0.0.1:8096
S_DEVLAB_ERP_TOKEN=demo-token
TREASURY_ERP_PORT=8096

# The signing service. THE SERVICE HOLDS NO KEY. Point this at a custody
# service or a KMS in a deployment.
TREASURY_SIGNER_URL=http://127.0.0.1:8098/sign
TREASURY_SIGNER_TOKEN=change-me
TREASURY_SIGNER_PUBLIC_KEY=

# The signing service's own token - the service that HOLDS THE KEY.
SIGNER_SERVICE_TOKEN=local-signer-token
