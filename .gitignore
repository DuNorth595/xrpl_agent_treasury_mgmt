# Generated state. These describe ONE devnet and are not valid anywhere
# else. They are rebuilt by `python3 dev_env.py fresh`.
var/
.dev-env/

# Run logs and results. Regenerated by the harnesses.
*.log
*.jsonl
scale-results/
scale-results-1m/
api-test-results/
api-test-results-readonly/
verification/
results/

# Credentials. The API credentials live in ~/.treasury-dev/, outside
# the repository, by design. These patterns are a second line of
# defence in case something writes one here.
*.token
api-tokens.json
.env
.env.*
!.env.example

# Build artifacts.
MANIFEST.json
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# The domain-gate proof is published SEPARATELY, as evidence about the
# XRPL rather than as part of this software.
evidence/

# Editor and OS noise.
.DS_Store
.idea/
.vscode/
*.swp
# Internal working notes and local devnet state.
BUILD_DECISIONS_*.md
CURRENT_STATE.md
DEV_README.md
NODE_UPGRADE_*.md
RESEARCH_AND_OUTLINE_*.md
STATUS_*.md
house/
screenshots/
assets/
docs/public/
enable_rippling.py
*.bak-pre-*
*.bak-superseded
node-upgrade-backup/
scale-results-settle/
